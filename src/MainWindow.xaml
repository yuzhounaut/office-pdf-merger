<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="资料合并 PDF · v1.4.3" Width="1200" Height="860" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" Foreground="#202733"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202733"/>
    <SolidColorBrush x:Key="Muted" Color="#667182"/>
    <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="Line" Color="#E5E8ED"/>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#202733"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" RadiusX="6" RadiusY="6" Stroke="#0067C0" StrokeThickness="2" StrokeDashArray="1,1"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#202733"/>
      <Setter Property="BorderBrush" Value="#DDE1E7"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
          <Grid><Border x:Name="Hover" Background="#09000000" Opacity="0" CornerRadius="4"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#16000000"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#005AAA"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Width" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FDFDFE"/><Setter Property="BorderBrush" Value="#DDE1E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
          <Grid><ScrollViewer x:Name="PART_ContentHost"/><Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Accent}" CornerRadius="0,0,4,4" Opacity="0"/></Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="Opacity" Value="1"/><Setter TargetName="Field" Property="Background" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" CornerRadius="4" BorderBrush="#9AA4B2" BorderThickness="1" Background="White"><TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
          <ContentPresenter Grid.Column="1" Margin="8,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="10,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="NavSurface" CornerRadius="6" Background="Transparent"><Grid><Border x:Name="Indicator" Width="3" Height="17" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter Margin="15,0" VerticalAlignment="Center"/></Grid></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#0A000000"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#E5EBF4"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#005FB8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="CornerRadius" Value="9"/><Setter Property="BorderBrush" Value="#E2E6EC"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Subtext" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Width="10"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="RailThumb" Background="#B7BEC9" Width="4" CornerRadius="2" Margin="0,3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailThumb" Property="Background" Value="#8693A4"/><Setter TargetName="RailThumb" Property="Width" Value="6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F8F9FB"/><Setter Property="Foreground" Value="#687586"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#EDF0F4"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="64"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#EEF1F5"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F8FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FC"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#E8EDF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border CornerRadius="3" Background="{TemplateBinding Background}"/><Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="RootGrid" Background="#F3F5F8">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Native WindowChrome retains resize, caption dragging and double-click maximize. -->
    <Grid Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0"><Image x:Name="AppLogo" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Office PDF 图标"/><TextBlock Text="资料合并 PDF" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="最小化"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="最大化或还原"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="关闭窗口" ToolTip="关闭窗口后，已启动的任务会继续"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="工作区" Margin="25,0,0,13" Foreground="#7A8491" FontSize="11"/>
          <RadioButton x:Name="MergeNav" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" AutomationProperties.Name="合并资料"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0" FontSize="17"/><TextBlock Text="合并资料" FontWeight="SemiBold"/></StackPanel></RadioButton>
          <RadioButton x:Name="HistoryNav" GroupName="Navigation" Style="{StaticResource NavButton}" AutomationProperties.Name="最近任务"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0" FontSize="17"/><TextBlock Text="最近任务"/></StackPanel></RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
          <RadioButton x:Name="HelpNav" GroupName="Navigation" Style="{StaticResource NavButton}" AutomationProperties.Name="使用帮助"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0" FontSize="17"/><TextBlock Text="使用帮助"/></StackPanel></RadioButton>
          <Border Height="1" Background="#E0E5ED" Margin="22,16,22,15"/>
          <StackPanel Margin="24,0,15,0"><TextBlock Text="本机处理" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="文件无需上传" Style="{StaticResource Subtext}" Margin="0,4,0,0"/><TextBlock Text="版本 1.4.3  ·  qpdf 已随附" FontSize="10" Foreground="#8993A1" Margin="0,14,0,0"/></StackPanel>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Margin="20,15,24,18">
        <Grid x:Name="MergePage"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="132"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="合并资料" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="把文档、演示和图片，整理成一份完整的 PDF。" Foreground="{StaticResource Muted}" Margin="1,8,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0" Background="#E9F3EC" CornerRadius="12" Padding="10,5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#267448" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="离线可用" Foreground="#267448" FontSize="11"/></StackPanel></Border></Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="SettingsColumn" Width="292"/></Grid.ColumnDefinitions>
            <Border x:Name="FilesCard" Style="{StaticResource Card}" AllowDrop="True">
              <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <DockPanel Margin="18,0,14,0"><TextBlock Text="文件清单" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F0F3F8" CornerRadius="10" Padding="8,3"><TextBlock x:Name="FileCount" Text="0 个文件" FontSize="11" Foreground="#637083"/></Border></DockPanel>
                <Grid Grid.Row="1" Margin="14,0,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="AddFilesButton" Style="{StaticResource Primary}" ToolTip="添加文件 (Ctrl+O)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="添加文件"/></StackPanel></Button>
                  <Button x:Name="AddFolderButton" Grid.Column="1" Margin="7,0,0,0" ToolTip="包含所选文件夹和子文件夹 (Ctrl+Shift+O)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="文件夹"/></StackPanel></Button>
                  <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="MoveUpButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="上移 (Alt+↑)" AutomationProperties.Name="上移"/>
                    <Button x:Name="MoveDownButton" Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="下移 (Alt+↓)" AutomationProperties.Name="下移"/>
                    <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="移除所选 (Delete)" AutomationProperties.Name="移除"/>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ClipToBounds="True">
                  <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeaderWidth="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="待合并文件列表">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="38"/>
                      <DataGridTemplateColumn Header="文件" Width="*" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="28" Height="34" CornerRadius="4" Background="{Binding KindBackground}" HorizontalAlignment="Left"><TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="Bold" Foreground="{Binding KindForeground}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8792A1" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTextColumn x:Name="GroupColumn" Header="分组" Binding="{Binding Group}" Width="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                      <DataGridTextColumn Header="页数" Binding="{Binding Pages}" Width="47"/>
                      <DataGridTemplateColumn Header="状态" Width="74"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StateBackground}" CornerRadius="4" Padding="5,4" HorizontalAlignment="Left"><TextBlock Text="{Binding State}" Foreground="{Binding StateForeground}" FontSize="10" ToolTip="{Binding Error}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Border x:Name="EmptyPanel" Background="White" Margin="1,34,1,0" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                      <Grid Width="104" Height="83" Margin="0,0,0,14">
                        <Border Width="48" Height="62" Background="#E8EDF5" BorderBrush="#D7E0EC" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" Margin="6,7,0,0"><Border.RenderTransform><RotateTransform Angle="-12" CenterX="24" CenterY="31"/></Border.RenderTransform></Border>
                        <Border Width="53" Height="68" Background="#FFFFFF" BorderBrush="#B4CDE8" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Top"><StackPanel Margin="10,15,10,0"><Border Background="#8BAFD4" Height="3" CornerRadius="1"/><Border Background="#CDDEEF" Height="3" Margin="0,7,0,0" CornerRadius="1"/><Border Background="#CDDEEF" Height="3" Margin="0,7,8,0" CornerRadius="1"/></StackPanel></Border>
                        <Border Width="28" Height="28" Background="#0067C0" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      </Grid>
                      <TextBlock Text="将资料拖到这里" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="或点击上方按钮添加文件 / 文件夹" Style="{StaticResource Subtext}" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                      <TextBlock Text="Word  ·  PowerPoint  ·  图片  ·  PDF" FontSize="11" Foreground="#8591A2" Margin="0,22,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="DropOverlay" Background="#EEF6FF" BorderBrush="#0067C0" BorderThickness="2" CornerRadius="7" Margin="10" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="松开即可添加" Foreground="#0067C0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
                <DockPanel Grid.Row="3" Margin="14,0,12,0"><Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="清空清单" Foreground="#667182" FontSize="11" Height="28" Padding="6,0" HorizontalAlignment="Right"/><TextBlock x:Name="ListHint" Text="清单顺序就是最终 PDF 的页序" FontSize="10" Foreground="#8893A0" VerticalAlignment="Center"/></DockPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,18,18,12">
                <StackPanel x:Name="SettingsPanel">
                  <TextBlock Text="输出设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,21"/>
                  <TextBlock Text="保存到" Margin="0,0,0,8" FontSize="12"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" Height="36" AutomationProperties.Name="输出目录"/><Button x:Name="BrowseOutputButton" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择输出目录" AutomationProperties.Name="选择输出目录"/></Grid>
                  <TextBlock Text="文件名称" Margin="0,17,0,8" FontSize="12"/>
                  <TextBox x:Name="NameBox" Text="总合并.pdf" Height="36" AutomationProperties.Name="文件名称"/>
                  <TextBlock Text="同名文件会自动另存，不覆盖原文件。" Style="{StaticResource Subtext}" FontSize="10" Margin="0,7,0,0"/>
                  <Border Height="1" Background="{StaticResource Line}" Margin="0,21,0,19"/>
                  <CheckBox x:Name="GroupCheck" AutomationProperties.Name="另存每组 PDF"><StackPanel><TextBlock Text="另存每组 PDF" FontSize="12"/><TextBlock Text="按一级子文件夹归组" Style="{StaticResource Subtext}" FontSize="10" Margin="0,5,0,0"/></StackPanel></CheckBox>
                  <CheckBox x:Name="SkipCheck" Margin="0,19,0,0" AutomationProperties.Name="跳过失败文件"><StackPanel><TextBlock Text="跳过失败文件" FontSize="12"/><TextBlock Text="结果会标注“不完整”" Style="{StaticResource Subtext}" FontSize="10" Margin="0,5,0,0"/></StackPanel></CheckBox>
                  <Grid Margin="0,23,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions><TextBlock Text="单文件超时" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="TimeoutBox" Grid.Column="1" Text="180" Height="34" Padding="8,5" HorizontalContentAlignment="Right" AutomationProperties.Name="单文件超时秒数"/><TextBlock Grid.Column="2" Text="秒" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                  <Border Background="#F5F8FD" CornerRadius="6" Padding="12" Margin="0,21,0,2"><StackPanel><TextBlock Text="保留原有版式" FontSize="11" FontWeight="SemiBold" Foreground="#3F6388"/><TextBlock Text="Word / PPT 保留页面比例。图片完整适配页面，不裁剪。" Foreground="#758698" FontSize="10" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Button x:Name="LogsButton" Grid.Column="1" Style="{StaticResource Quiet}" Height="23" Padding="5,0" FontSize="11" Content="查看日志" Foreground="#0067C0"/></Grid>
                <TextBlock x:Name="StatusDetail" Grid.Row="1" Text="添加资料后，即可开始合并。" Style="{StaticResource Subtext}" FontSize="11" Margin="0,6,0,7" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                <StackPanel Grid.Row="2"><ProgressBar x:Name="JobProgress" Maximum="100" Value="0"/><TextBlock x:Name="Metrics" Text="文件在本机完成转换和合并" Foreground="#85909E" FontSize="10" Margin="0,7,0,0"/></StackPanel>
              </Grid>
              <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="8"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <Button x:Name="StartButton" Style="{StaticResource Primary}" Height="44" ToolTip="开始合并 (Ctrl+Enter)" AutomationProperties.Name="生成 PDF"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="生成 PDF" FontSize="14"/></StackPanel></Button>
                <Grid Grid.Row="2"><Button x:Name="OpenOutputButton" Style="{StaticResource Quiet}" Content="打开输出目录" FontSize="12"/><Button x:Name="CancelButton" Content="取消任务" Visibility="Collapsed" FontSize="12"/></Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="最近任务" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="查看本机的处理记录，或继续查看正在运行的任务。" Foreground="{StaticResource Muted}" Margin="1,8,0,0"/></StackPanel><Button x:Name="RefreshHistoryButton" Content="刷新" Width="70" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0"/></Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="14" BorderBrush="#E8ECF2" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#788596" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding State}" Foreground="#0067C0" HorizontalAlignment="Right"/><TextBlock Text="{Binding When}" Foreground="#8A95A3" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBlock x:Name="HistoryEmpty" Text="还没有任务记录。先添加资料，生成第一份 PDF。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7A8797"/>
            <Button x:Name="LoadHistoryButton" Grid.Row="1" Content="查看所选任务" HorizontalAlignment="Right" Padding="18,0" VerticalAlignment="Bottom" Style="{StaticResource Primary}"/>
          </Grid></Border>
        </Grid>
        <Grid x:Name="HelpPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="使用帮助" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="从零散资料，到一份完整的 PDF。" Foreground="{StaticResource Muted}" Margin="1,8,0,0"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="三步完成合并" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. 添加 Word、PPT、图片或 PDF，也可以拖入整个文件夹。&#10;&#10;2. 用上移 / 下移调整顺序，设置输出目录和文件名称。&#10;&#10;3. 点击“生成 PDF”，程序自动转换、合并，并检查页数。" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,26"/>
            <Border Height="1" Background="{StaticResource Line}"/>
            <TextBlock Text="开始前需要知道" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,14"/>
            <TextBlock Text="图片和 PDF 可直接处理；Word / PPT 需要本机安装对应的 Microsoft Office。qpdf 已随附，无需下载或单独安装。请保留解压后的完整软件文件夹。&#10;&#10;默认遇到错误就停止。勾选“跳过失败文件”后，输出会标注“不完整”，源文件清单中会注明失败原因。&#10;&#10;关闭窗口后任务继续。重新打开程序，或在“最近任务”中恢复查看；取消按钮会停止当前任务。&#10;&#10;处理清单与日志保存在程序目录 OfficePdfData 中，记录源文件、起始页和页数，不打扰输出文件夹。动画、视频等动态内容只保留静态页面。" TextWrapping="Wrap" LineHeight="23" Foreground="#667182"/>
            <TextBlock Text="键盘操作" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,12"/><TextBlock Text="Ctrl+O 添加文件    ·    Ctrl+Shift+O 添加文件夹&#10;Alt+↑ / Alt+↓ 调整顺序    ·    Delete 移除所选&#10;Ctrl+Enter 开始合并    ·    Tab 切换控件" Foreground="#667182" LineHeight="25" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
